{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HushType",
  "version": "0.3.2",
  "identifier": "com.hushtype.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HushType",
        "label": "main",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0d0d0c"
      },
      {
        "title": "HushType recording",
        "label": "overlay",
        "url": "index.html?overlay=1",
        "width": 96,
        "height": 52,
        "minWidth": 96,
        "minHeight": 52,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HushType",
    "shortDescription": "Private, bring-your-own-model voice dictation",
    "longDescription": "Cross-platform voice dictation with raw transcription and optional AI cleanup.",
    "category": "Productivity",
    "copyright": "Copyright © 2026 HushType",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
